# Copy to .env.local, or let `npm run set-admin-password` write it for you.
# .env.local is gitignored — never commit real values.

# The single address allowed to sign in at /admin/login.
ADMIN_EMAIL=you@example.com

# scrypt hash of the admin password, in the form
#   scrypt:<N>:<r>:<p>:<salt base64url>:<hash base64url>
# Generate with:
#   npm run set-admin-password -- --email you@example.com --password "your password"
# The plaintext password is never stored.
ADMIN_PASSWORD_HASH=

# HMAC key used to sign the admin session cookie. At least 32 characters.
# Generated automatically by the script above. Changing it signs you out.
AUTH_SECRET=

# Public base URL, used for canonical links and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
